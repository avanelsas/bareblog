;; The blog app. `bareblog preview` serves what this build writes, and a publish copies it.
;; The BareDOM version is named here, in bb.edn, in package.json and in app.live. A test holds
;; them to each other.
{:source-paths ["src"]
 :dependencies [[com.github.avanelsas/baredom "4.15.0"]]
 :builds       {:app {:target     :esm
                      :output-dir "resources/public/js"
                      :modules    {:app {:init-fn bareblog.app.core/init}}}}}
