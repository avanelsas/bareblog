{:paths ["src" "test"]
 ;; The same release that shadow-cljs.edn, package.json and app.live name. Here it gives the
 ;; tests BareMirror's pure template functions, and BareDOM's request events to read.
 :deps  {com.github.avanelsas/baredom {:mvn/version "4.17.0"}}
 :tasks
 {test  {:doc      "Run the tests of the pure code."
         :requires ([bareblog.test-runner])
         :task     (bareblog.test-runner/run)}
  inbox {:doc      "Print the script of the comments inbox, for the template sheet."
         :requires ([bareblog.command.inbox])
         :task     (print (bareblog.command.inbox/read-script "."))}}}
